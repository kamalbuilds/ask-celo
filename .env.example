# Facilitator credits. Human step: https://x402.celo.org → connect wallet →
# Create API key (a signature, no gas, no transaction). Shown once.
X402_API_KEY=x402_...

# testnet | mainnet. Develop on testnet; it starts with free credits.
X402_NETWORK=testnet

# Your receiving wallet. Buyer funds land here directly, inside the token
# contract. Not the facilitator, not the buyer.
SELLER_PAY_TO=0x

# Issued by celobuilders at registration, derived from the GitHub owner/repo
# slug and locked at first save. Only this exact code is credited, so a
# self-derived one earns nothing.
VITE_ATTRIBUTION_TAG=celo_

# Backs the paid endpoint. Without it the seller refuses to serve a paid call
# rather than returning a stub.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ERC-8004 identity. Metadata is pinned to IPFS so the CID is the integrity
# check; an https URI can be swapped after registration.
AGENT_DOMAIN=https://
AGENT_NAME=Ask
AGENT_PRIVATE_KEY=
PINATA_JWT=
